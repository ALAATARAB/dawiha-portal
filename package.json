{
    "name": "dawiha-portal-react",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:host": "vite --host",
        "build:dev": "cross-env NODE_ENV=development tsc -b && vite build --mode development",
        "build:prod": "cross-env NODE_ENV=production tsc -b && vite build --mode production",
        "build:prod:skip-check": "cross-env NODE_ENV=production vite build --mode production",
        "preview": "vite preview",
        "lint": "eslint . --ext .ts,.tsx",
        "lint:fix": "eslint . --ext .ts,.tsx --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
        "spell-check": "cspell \"src/**/*.{ts,tsx,js,jsx,md}\"",
        "spell-check:report": "cspell \"src/**/*.{ts,tsx,js,jsx,md}\" --no-color",
        "check:all": "npm run lint:fix && npm run format && npm run spell-check",
        "check:partial": "npm run spell-check",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{js,jsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.0",
        "@mui/icons-material": "^7.1.0",
        "@mui/material": "^7.1.0",
        "@mui/x-charts": "^8.6.0",
        "@mui/x-data-grid": "^8.4.0",
        "@mui/x-date-pickers": "^8.6.0",
        "@reduxjs/toolkit": "^2.8.2",
        "@toolpad/core": "^0.15.0",
        "@types/react": "^19.1.3",
        "@types/react-dom": "^19.1.3",
        "axios": "^1.9.0",
        "date-fns": "^4.1.0",
        "dotenv": "^16.5.0",
        "file-saver": "^2.0.5",
        "i18next": "^25.2.0",
        "i18next-browser-languagedetector": "^8.1.0",
        "js-cookie": "^3.0.5",
        "libphonenumber-js": "^1.12.41",
        "lodash": "^4.17.21",
        "mui-tel-input": "^10.0.0",
        "react": "^19.1.4",
        "react-dom": "^19.1.4",
        "react-hook-form": "^7.57.0",
        "react-i18next": "^15.5.1",
        "react-redux": "^9.2.0",
        "react-router-dom": "^7.6.0",
        "recharts": "^2.15.3",
        "zod": "^3.25.7"
    },
    "devDependencies": {
        "@eslint/js": "^9.25.0",
        "@types/file-saver": "^2.0.7",
        "@types/js-cookie": "^3.0.6",
        "@types/lodash": "^4.17.19",
        "@types/node": "^24.0.1",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.2",
        "@vitejs/plugin-react": "^4.4.1",
        "cross-env": "^7.0.3",
        "cspell": "^9.1.1",
        "eslint": "^9.25.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "eslint-plugin-unused-imports": "^4.1.4",
        "globals": "^16.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.1.2",
        "prettier": "^3.5.3",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.30.1",
        "vite": "^6.3.5"
    }
}
